# 301 redirect: /netlify/<anything> → Google search for <anything>
/netlify/*    https://www.google.com/search?q=:splat    301

# Proxy redirect example
/api/*        https://httpbin.org/:splat                200

# Function redirect: /api/hello → /.netlify/functions/hello
/api/hello    /.netlify/functions/hello                 200